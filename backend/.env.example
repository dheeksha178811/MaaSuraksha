# --- Required everywhere ---
DATABASE_URL=            # Neon connection string (sslmode=require)
JWT_SECRET=              # production: random, >= 32 chars, not all digits
JWT_EXPIRES_IN=7d
PORT=5000                # Render sets this automatically

# --- Required in production ---
NODE_ENV=production
FRONTEND_URL=            # exact deployed frontend origin, e.g. https://maasuraksha.vercel.app (comma-separate for several)
TRUST_PROXY=1            # proxy hops in front of the API (Render = 1)

# --- Optional rate-limit tuning ---
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_PASSWORD_RESET_MAX=5
